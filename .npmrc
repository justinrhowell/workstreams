# Next 14.2 declares a peer dependency on React ^18.2, but this project runs
# React 19. The combination works, and the app builds and runs against it, but
# npm's strict peer resolution refuses to install it.
#
# This is what makes `npm ci` reproducible here and in CI. Remove it once Next
# is upgraded to 16, which supports React 19 natively.
legacy-peer-deps=true
